{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenCut",
  "version": "0.1.2",
  "identifier": "app.opencut.desktop",
  "mainBinaryName": "OpenCut",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCut",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,msWebOOUI,msPdfOOUI --disable-background-networking --disable-component-update --disable-sync --disable-domain-reliability"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["resources/server/**/*"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
